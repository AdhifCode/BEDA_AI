# Application Environment
APP_ENV=development
APP_NAME=beda-enquiry-intelligence
API_PORT=8000
API_HOST=0.0.0.0

# Database Configuration (Postgres default; supports sqlite for lightweight local testing)
DATABASE_URL=sqlite+aiosqlite:///./beda.db
# For Docker Postgres:
# DATABASE_URL=postgresql+psycopg://beda:beda@localhost:5434/beda

# Redis / Queue Configuration (Supports in-memory fallback when REDIS_URL is empty or 'memory')
REDIS_URL=memory
# For Redis:
# REDIS_URL=redis://localhost:6379/0

# LLM Gateway Configuration
# Providers: fake | openrouter | openai | openai-compatible
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_BASE_URL=
LLM_PRIMARY_MODEL=z-ai/glm-5.2:free
LLM_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free
LLM_ESCALATION_MODEL=google/gemma-4-31b-it:free
LLM_CLASSIFICATION_MODEL=fast-model
LLM_STRONG_MODEL=z-ai/glm-5.2:free
LLM_CONFIDENCE_THRESHOLD=0.80
LLM_MAX_INPUT_TOKENS=6000
LLM_MAX_OUTPUT_TOKENS=1500
LLM_TIMEOUT=45.0

# Example OpenRouter Configuration with Multi-Model Backup:
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-v1-your-openrouter-key-here
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_PRIMARY_MODEL=z-ai/glm-5.2:free
# LLM_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free
# LLM_ESCALATION_MODEL=google/gemma-4-31b-it:free
# (Alternative free models: google/gemini-2.0-flash-exp:free, qwen/qwen-2.5-72b-instruct:free)
# OPENROUTER_REFERER=http://localhost:8000
# OPENROUTER_TITLE=BEDA Enquiry Intelligence

# CRM Adapter Configuration
CRM_PROVIDER=mock
CRM_BASE_URL=
CRM_API_KEY=

# Authentication & Access Control
AUTH_MODE=local
SECRET_KEY=beda-development-secret-key-change-in-production-12345

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
